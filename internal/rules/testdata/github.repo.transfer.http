# source: https://docs.github.com/en/rest/repos/repos#transfer-a-repository
# resource: acme/prod-api
POST https://api.github.com/repos/acme/prod-api/transfer
Accept: application/vnd.github+json
X-GitHub-Api-Version: 2022-11-28
Content-Type: application/json

{"new_owner":"other-org","new_name":"prod-api"}
###
# safe: reading the same repository
GET https://api.github.com/repos/acme/prod-api
Accept: application/vnd.github+json

###
# safe: creating an issue in the same repository
POST https://api.github.com/repos/acme/prod-api/issues
Accept: application/vnd.github+json
Content-Type: application/json

{"title":"x"}
