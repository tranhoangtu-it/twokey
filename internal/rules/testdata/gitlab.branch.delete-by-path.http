# source: https://docs.gitlab.com/api/branches/#delete-repository-branch
# resource: acme/api:release-1.2
DELETE https://gitlab.com/api/v4/projects/acme%2Fapi/repository/branches/release-1.2
PRIVATE-TOKEN: TOKEN

###
# safe: reading the same branch
GET https://gitlab.com/api/v4/projects/acme%2Fapi/repository/branches/release-1.2
PRIVATE-TOKEN: TOKEN

###
# safe: creating a branch
POST https://gitlab.com/api/v4/projects/acme%2Fapi/repository/branches?branch=release-1.2&ref=main
PRIVATE-TOKEN: TOKEN
