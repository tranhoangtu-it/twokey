# source: https://docs.cloud.google.com/compute/docs/reference/rest/v1/regionDisks/delete
# resource: my-project/us-central1/ha-disk
DELETE https://compute.googleapis.com/compute/v1/projects/my-project/regions/us-central1/disks/ha-disk
###
# safe: reading the same regional disk
GET https://compute.googleapis.com/compute/v1/projects/my-project/regions/us-central1/disks/ha-disk
###
# safe: snapshotting the regional disk
POST https://compute.googleapis.com/compute/v1/projects/my-project/regions/us-central1/disks/ha-disk/createSnapshot
Content-Type: application/json

{"name":"ha-disk-snap"}
