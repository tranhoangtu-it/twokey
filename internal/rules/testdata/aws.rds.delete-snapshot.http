# source: https://docs.aws.amazon.com/AmazonRDS/latest/APIReference/API_DeleteDBSnapshot.html
# resource: prod-db-nightly
POST https://rds.us-east-1.amazonaws.com/
Content-Type: application/x-www-form-urlencoded; charset=utf-8

Action=DeleteDBSnapshot&DBSnapshotIdentifier=prod-db-nightly&Version=2014-10-31
###
# safe: reading the same snapshot
POST https://rds.us-east-1.amazonaws.com/
Content-Type: application/x-www-form-urlencoded; charset=utf-8

Action=DescribeDBSnapshots&DBSnapshotIdentifier=prod-db-nightly&Version=2014-10-31
###
# safe: copying the snapshot is not a delete
POST https://rds.us-east-1.amazonaws.com/
Content-Type: application/x-www-form-urlencoded; charset=utf-8

Action=CopyDBSnapshot&SourceDBSnapshotIdentifier=prod-db-nightly&TargetDBSnapshotIdentifier=prod-db-copy&Version=2014-10-31
