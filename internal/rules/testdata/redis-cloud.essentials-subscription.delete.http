# source: https://redis.io/docs/latest/operate/rc/api/examples/manage-subscriptions/#delete-an-essentials-subscription
# resource: 98765
DELETE https://api.redislabs.com/v1/fixed/subscriptions/98765
x-api-key: $REDIS_ACCOUNT_KEY
x-api-secret-key: $REDIS_SECRET_KEY

###
# safe: reading the same subscription
GET https://api.redislabs.com/v1/fixed/subscriptions/98765
x-api-key: $REDIS_ACCOUNT_KEY
x-api-secret-key: $REDIS_SECRET_KEY

###
# safe: renaming the subscription
PUT https://api.redislabs.com/v1/fixed/subscriptions/98765
Content-Type: application/json
x-api-key: $REDIS_ACCOUNT_KEY
x-api-secret-key: $REDIS_SECRET_KEY

{"name":"new-subscription-name"}
