# source: https://docs.aws.amazon.com/AmazonECR/latest/APIReference/API_DeleteRepository.html
# resource: sample-repo
POST https://api.ecr.us-west-2.amazonaws.com/
Content-Type: application/x-amz-json-1.1
X-Amz-Target: AmazonEC2ContainerRegistry_V20150921.DeleteRepository

{"repositoryName": "sample-repo"}
###
# safe: reading the same repository
POST https://api.ecr.us-west-2.amazonaws.com/
Content-Type: application/x-amz-json-1.1
X-Amz-Target: AmazonEC2ContainerRegistry_V20150921.DescribeRepositories

{"repositoryNames": ["sample-repo"]}
###
# safe: creating a repository
POST https://api.ecr.us-west-2.amazonaws.com/
Content-Type: application/x-amz-json-1.1
X-Amz-Target: AmazonEC2ContainerRegistry_V20150921.CreateRepository

{"repositoryName": "sample-repo-2"}
