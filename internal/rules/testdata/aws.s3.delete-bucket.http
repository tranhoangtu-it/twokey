# source: https://docs.aws.amazon.com/AmazonS3/latest/API/API_DeleteBucket.html
# resource: amzn-s3-demo-bucket.s3.us-east-1.amazonaws.com
DELETE https://amzn-s3-demo-bucket.s3.us-east-1.amazonaws.com/
###
# safe: listing the same bucket
GET https://amzn-s3-demo-bucket.s3.us-east-1.amazonaws.com/?list-type=2
###
# safe: DeleteBucketPolicy removes a subresource, not the bucket
DELETE https://amzn-s3-demo-bucket.s3.us-east-1.amazonaws.com/?policy
###
# safe: DeleteBucketMetadataConfiguration removes a subresource, not the bucket
DELETE https://amzn-s3-demo-bucket.s3.us-east-1.amazonaws.com/?metadataConfiguration
